---
interface Props {
  novelTitle: string;
  novelUrl: string;
  arc: number;
  chapter: number;
  title: string;
  words: number;
  minutes: number;
}
const { novelTitle, novelUrl, arc, chapter, title, words, minutes } = Astro.props;
const fmt = new Intl.NumberFormat('vi-VN');
---
<header>
  <p class="crumb"><a href="/">Trang chủ</a> / <a href={novelUrl}>{novelTitle}</a> / Arc {arc}</p>
  <p class="chapter-kicker">Chương {chapter}</p>
  <h1 class="chapter-title">{title}</h1>
  <p class="chapter-meta">{fmt.format(words)} từ · Khoảng {minutes} phút đọc</p>
</header>
