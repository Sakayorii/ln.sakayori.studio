---
/* Flat approved comments + submission form (Turnstile + honeypot + pending queue). */
interface Props { novel: string; arc: number; chapter: number; }
const { novel, arc, chapter } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<section class="comments" id="comments" aria-label="Bình luận"
  data-novel={novel} data-arc={arc} data-chapter={chapter} data-sitekey={siteKey}>
  <h2>Bình luận</h2>
  <p class="mod-note">Bình luận sẽ hiển thị sau khi được ban biên tập duyệt.</p>
  <div id="comment-list"><p class="mod-note">Đang tải bình luận…</p></div>

  <form class="comment-form" id="comment-form">
    <h3>Viết bình luận</h3>
    <div class="row">
      <input type="text" id="c-name" maxlength="30" placeholder="Tên hiển thị" required autocomplete="nickname" />
    </div>
    <textarea id="c-content" maxlength="500" placeholder="Cảm nghĩ của bạn về chương này..." required></textarea>
    <input type="text" id="c-hp" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="turnstile-slot" id="comment-turnstile" style="margin:12px 0;"></div>
    <button class="btn" type="submit" id="c-send">Gửi bình luận</button>
    <p class="form-note">Không đăng liên kết. Bình luận chờ duyệt mới hiển thị.</p>
  </form>
</section>

<script>
  import { showToast } from '../utils/reader-settings';
  import { toSvg } from '../utils/peek/index.js';
  const section = document.getElementById('comments') as HTMLElement;
  const novel = section.dataset.novel!;
  const arc = parseInt(section.dataset.arc!, 10);
  const chapter = parseInt(section.dataset.chapter!, 10);
  const siteKey = section.dataset.sitekey || '';
  const list = document.getElementById('comment-list') as HTMLElement;
  const form = document.getElementById('comment-form') as HTMLFormElement;
  const t0 = Date.now();
  let tsWidget;

  function esc(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }
  function fmtTime(ts: number) {
    return new Date(ts * 1000).toLocaleString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  async function load() {
    try {
      const res = await fetch(`/api/comments?novel=${novel}&arc=${arc}&chapter=${chapter}`);
      if (!res.ok) throw new Error();
      const items = await res.json();
      if (!items.length) { list.innerHTML = '<p class="mod-note">Chưa có bình luận nào. Hãy là người đầu tiên.</p>'; return; }
      list.innerHTML = '';
      for (const c of items) {
        const div = document.createElement('div');
        div.className = 'comment';
        const avatar = toSvg(c.author_name, { size: 40, square: false });
        div.innerHTML = `<div class="who"><span class="avatar">${avatar}</span><span>${esc(c.author_name)}</span><span class="when">${fmtTime(c.created_at)}</span></div><p class="what"></p>`;
        (div.querySelector('.what') as HTMLElement).textContent = c.content;
        list.appendChild(div);
      }
    } catch { list.innerHTML = '<p class="mod-note">Không tải được bình luận lúc này.</p>'; }
  }

  // Turnstile explicit render
  function ensureTurnstile() {
    if (!siteKey || tsWidget !== undefined) return;
    const slot = document.getElementById('comment-turnstile');
    if ((window as any).turnstile && slot) tsWidget = (window as any).turnstile.render(slot, { sitekey: siteKey });
  }
  if (document.readyState === 'complete') ensureTurnstile();
  else window.addEventListener('load', ensureTurnstile);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('c-send') as HTMLButtonElement;
    const name = (document.getElementById('c-name') as HTMLInputElement).value.trim();
    const content = (document.getElementById('c-content') as HTMLTextAreaElement).value.trim();
    if (name.length < 2 || content.length < 3) { showToast('Tên quá ngắn hoặc bình luận quá ngắn.'); return; }
    btn.disabled = true;
    try {
      const token = siteKey && (window as any).turnstile && tsWidget !== undefined
        ? (window as any).turnstile.getResponse(tsWidget) : '';
      const res = await fetch('/api/comments', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          novel, arc, chapter, author_name: name, content,
          website_url: (document.getElementById('c-hp') as HTMLInputElement).value,
          t0, turnstileToken: token,
        }),
      });
      if (res.status === 429) { showToast('Bạn gửi quá nhanh. Thử lại sau một lúc.'); return; }
      if (!res.ok) throw new Error();
      (document.getElementById('c-content') as HTMLTextAreaElement).value = '';
      showToast('Bình luận đã được ghi nhận và đang chờ kiểm duyệt.');
    } catch { showToast('Gửi bình luận chưa thành công. Thử lại sau.'); }
    finally { btn.disabled = false; }
  });

  load();
</script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
