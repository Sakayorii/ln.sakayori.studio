<div class="modal-backdrop" id="search-modal" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
  <div class="modal-card">
    <div class="search-topline">
      <h3 id="search-modal-title">Tìm kiếm chương</h3>
      <button type="button" class="btn-icon" id="btn-close-search" aria-label="Đóng tìm kiếm">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg>
      </button>
    </div>
    <label class="sr-only" for="search-input">Số chương hoặc tiêu đề</label>
    <input type="search" class="comment-input" id="search-input" placeholder="Nhập số chương hoặc tiêu đề…" autocomplete="off" />
    <div id="search-results" class="search-results" aria-live="polite"><p class="search-status">Nhập từ khóa để tìm chương.</p></div>
  </div>
</div>
<script>
  const modal = document.getElementById('search-modal')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results')!;
  const closeButton = document.getElementById('btn-close-search')!;
  let opener: HTMLElement | null = null;
  let pagefind: Promise<any> | null = null;
  let version = 0;
  let timer: ReturnType<typeof setTimeout>;
  function status(message: string) {
    const p = document.createElement('p'); p.className = 'search-status'; p.textContent = message; results.replaceChildren(p);
  }
  function openSearch() {
    opener = document.activeElement as HTMLElement;
    modal.classList.add('open'); document.body.style.overflow = 'hidden'; input.focus();
  }
  function closeSearch() {
    modal.classList.remove('open'); document.body.style.overflow = ''; version++; clearTimeout(timer);
    input.value = ''; status('Nhập từ khóa để tìm chương.'); opener?.focus();
  }
  document.getElementById('btn-open-search')?.addEventListener('click', openSearch);
  closeButton.addEventListener('click', closeSearch);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeSearch(); });
  window.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    const typing = target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName);
    if (e.key === 'Escape' && modal.classList.contains('open')) closeSearch();
    if (!typing && (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key === 'k'))) { e.preventDefault(); openSearch(); }
    if (e.key === 'Tab' && modal.classList.contains('open')) {
      const focusables = Array.from(modal.querySelectorAll<HTMLElement>('button, input, a[href]'));
      const first = focusables[0], last = focusables.at(-1);
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last?.focus(); }
      if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus(); }
    }
  });
  input.addEventListener('input', () => {
    clearTimeout(timer); const request = ++version; const query = input.value.trim();
    if (!query) { status('Nhập từ khóa để tìm chương.'); return; }
    timer = setTimeout(async () => {
      status('Đang tìm kiếm…');
      try {
        const moduleUrl = '/pagefind/pagefind.js';
        pagefind ??= import(/* @vite-ignore */ moduleUrl);
        const pf = await pagefind;
        const found = await pf.search(query);
        const items = await Promise.all(found.results.slice(0, 8).map((r: any) => r.data()));
        if (request !== version) return;
        if (!items.length) { status('Không tìm thấy chương phù hợp. Thử số chương hoặc từ khóa khác.'); return; }
        results.replaceChildren();
        for (const item of items) {
          const url = new URL(item.url, location.origin); if (url.origin !== location.origin) continue;
          const a = document.createElement('a'); a.href = url.pathname; a.className = 'search-result';
          const title = document.createElement('strong'); title.textContent = item.meta?.title || 'Chương truyện';
          const excerpt = document.createElement('p'); const parsed = new DOMParser().parseFromString(item.excerpt || '', 'text/html'); excerpt.textContent = parsed.body.textContent;
          a.append(title, excerpt); results.append(a);
        }
      } catch {
        pagefind = null;
        if (request === version) status('Chưa tải được tìm kiếm. Thử lại hoặc mở mục lục để chọn chương.');
      }
    }, 200);
  });
</script>
