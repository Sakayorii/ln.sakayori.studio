---
import Icon from './Icon.astro';
interface Props {
  homeUrl?: string;
}
const { homeUrl = '/' } = Astro.props;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={homeUrl} aria-label="Trang chủ">
      <img src="/logo.svg" alt="" width="28" height="28" />
      <span class="brand-name">Sakayori</span>
    </a>
    <nav class="site-nav" aria-label="Điều hướng chính">
      <a href="/">Thư viện</a>
      <button class="icon-btn" data-open-search aria-label="Tìm kiếm">
        <Icon name="search" />
      </button>
      <slot name="actions" />
    </nav>
  </div>
</header>
