---
import { getCollection, render } from 'astro:content';
import ReaderLayout from '../../../layouts/ReaderLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import ProgressBar from '../../../components/ProgressBar.astro';
import ChapterHeader from '../../../components/ChapterHeader.astro';
import ChapterNav from '../../../components/ChapterNav.astro';
import ReaderSettings from '../../../components/ReaderSettings.astro';
import TypoReport from '../../../components/TypoReport.astro';
import Comments from '../../../components/Comments.astro';
import BackToTop from '../../../components/BackToTop.astro';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  const novels = await getCollection('novels');
  const byNovel = new Map<string, typeof chapters>();
  for (const c of chapters) {
    if (!byNovel.has(c.data.novel)) byNovel.set(c.data.novel, []);
    byNovel.get(c.data.novel)!.push(c);
  }
  for (const list of byNovel.values()) {
    list.sort((a, b) => a.data.arc - b.data.arc || a.data.chapter - b.data.chapter);
  }
  return chapters.map((entry) => {
    const list = byNovel.get(entry.data.novel)!;
    const i = list.findIndex((e) => e.id === entry.id);
    const novel = novels.find((n) => n.id === entry.data.novel);
    const link = (e: (typeof list)[number] | undefined) =>
      e ? { url: `/${e.data.novel}/arc-${e.data.arc}/chuong-${e.data.chapter}`, label: `Chương ${e.data.chapter}: ${e.data.title}` } : null;
    return {
      params: {
        novel: entry.data.novel,
        arc: `arc-${entry.data.arc}`,
        chapter: `chuong-${entry.data.chapter}`,
      },
      props: {
        entry,
        novelTitle: novel?.data.title ?? entry.data.novel,
        prev: link(list[i - 1]),
        next: link(list[i + 1]),
        siblings: list.map((e) => ({ chapter: e.data.chapter, title: e.data.title, url: `/${e.data.novel}/arc-${e.data.arc}/chuong-${e.data.chapter}` })),
      },
    };
  });
}

const { entry, novelTitle, prev, next, siblings } = Astro.props;
const { Content } = await render(entry);
const { novel, arc, chapter, title } = entry.data;

const words = entry.body ? entry.body.split(/\s+/).filter(Boolean).length : 0;
const minutes = Math.max(1, Math.ceil(words / 200));
const pageTitle = `Chương ${chapter}: ${title} | ${novelTitle} - Sakayori Studio`;
const excerpt = (entry.body || '')
  .replace(/[#*`>~\-—]/g, '')
  .replace(/△▼△▼△▼△/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 150);
const description = excerpt.length > 20 ? excerpt : `Đọc chương ${chapter} - ${title}. Bản dịch tiếng Việt phi lợi nhuận của Sakayori Studio.`;
---
<ReaderLayout title={pageTitle} description={description}>
  <ProgressBar />
  <SiteHeader />

  <main class="chapter-wrap">
    <!-- Pagefind indexes ONLY this metadata block, never the full chapter text -->
    <div data-pagefind-body data-pagefind-meta="title:{pageTitle}">
      <ChapterHeader
        novelTitle={novelTitle}
        novelUrl={`/${novel}/`}
        arc={arc}
        chapter={chapter}
        title={title}
        words={words}
        minutes={minutes}
      />
      <p class="chapter-meta" style="margin-top:-28px;">{excerpt}</p>
    </div>

    <ChapterNav prev={prev} next={next} siblings={siblings} current={chapter} />

    <!-- SAMPLE CONTENT: thay bằng chương thật khi nội dung arc lên main -->
    <article class="chapter-body" id="chapter-body">
      <Content />
    </article>

    <ChapterNav prev={prev} next={next} siblings={siblings} current={chapter} bottom />

    <TypoReport novel={novel} arc={arc} chapter={chapter} />

    <Comments novel={novel} arc={arc} chapter={chapter} />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="foot-brand"><img src="/logo.svg" alt="" width="22" height="22" /> SAKAYORI STUDIO</div>
      <p class="disclaimer">
        Bản dịch tiếng Việt phi thương mại được thực hiện bởi Sakayori Studio phục vụ mục đích
        đọc và học tập phi lợi nhuận. Toàn bộ bản quyền tác phẩm gốc và minh họa thuộc về các
        tác giả và nhà xuất bản gốc. Vui lòng mua sách gốc để ủng hộ tác giả khi có điều kiện.
      </p>
    </div>
  </footer>

  <ReaderSettings />
  <BackToTop />
</ReaderLayout>

<script define:vars={{ novel, novelTitle, arc, chapter, chapterTitle: title }}>
  import { saveResume, loadResume } from '../../../utils/reader-settings';
  const url = `/${novel}/arc-${arc}/chuong-${chapter}`;
  // restore scroll position
  const saved = loadResume();
  if (saved && saved.url === url && saved.scrollY > 0) {
    requestAnimationFrame(() => window.scrollTo({ top: saved.scrollY, behavior: 'instant' }));
  }
  // save progress (throttled)
  let t = 0;
  const save = () => {
    saveResume({ novel, novelTitle, arc, chapter, chapterTitle, url, scrollY: window.scrollY });
  };
  window.addEventListener('scroll', () => {
    const now = Date.now();
    if (now - t > 1500) { t = now; save(); }
  }, { passive: true });
  window.addEventListener('beforeunload', save);
</script>
