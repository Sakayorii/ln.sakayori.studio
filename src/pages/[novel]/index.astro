---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SearchModal from '../../components/SearchModal.astro';
import BackToTop from '../../components/BackToTop.astro';

export async function getStaticPaths() {
  const novels = await getCollection('novels');
  return novels.map((novel) => ({
    params: { novel: novel.id },
    props: { novel },
  }));
}

const { novel } = Astro.props;
const allChapters = await getCollection('chapters', (c) => c.data.novel === novel.id);

// Group chapters by Arc
const arcsMap = new Map<number, typeof allChapters>();
for (const ch of allChapters) {
  const arcNum = ch.data.arc;
  if (!arcsMap.has(arcNum)) arcsMap.set(arcNum, []);
  arcsMap.get(arcNum)!.push(ch);
}

const sortedArcs = Array.from(arcsMap.entries()).sort((a, b) => a[0] - b[0]);
for (const [, list] of sortedArcs) {
  list.sort((a, b) => a.data.chapter - b.data.chapter);
}

const pageTitle = `${novel.data.title} | Sakayori Studio`;
const description = novel.data.summary.slice(0, 160);
---
<BaseLayout title={pageTitle} description={description}>
  <div style="min-height: 100vh; background: #f4ecd8; color: #3d3428; display: flex; flex-direction: column;">
    <main style="width: 100%; max-width: 840px; margin: 0 auto; padding: 24px 20px 80px; flex: 1;">
      <SiteHeader />

      <!-- Novel Header Showcase -->
      <section style="margin: 32px 0 40px; padding-bottom: 28px; border-bottom: 2px solid #d5c8b5;">
        <div style="display: flex; gap: 24px; flex-wrap: wrap; align-items: flex-start;">
          <div style="flex: 1; min-width: 280px;">
            <p style="font-family: 'Be Vietnam Pro', sans-serif; font-size: 13px; color: #b45309; font-weight: 600; letter-spacing: 0.05em; margin-bottom: 6px;">
              {novel.data.originalTitle || 'LIGHT NOVEL'}
            </p>
            <h1 style="font-size: clamp(26px, 4vw, 36px); font-weight: 700; line-height: 1.3; margin-bottom: 14px;">
              {novel.data.title}
            </h1>
            <div style="font-family: 'Be Vietnam Pro', sans-serif; font-size: 13px; opacity: 0.8; display: flex; gap: 16px; margin-bottom: 18px;">
              <span>Tác giả: <strong>{novel.data.author}</strong></span>
              <span>·</span>
              <span>Bản dịch: <strong>{novel.data.translator}</strong></span>
              <span>·</span>
              <span>Trạng thái: <strong>{novel.data.status === 'ongoing' ? 'Đang tiến hành' : 'Hoàn thành'}</strong></span>
            </div>
            <p style="font-size: 15px; line-height: 1.7; opacity: 0.9; text-align: justify;">
              {novel.data.summary}
            </p>
          </div>
        </div>
      </section>

      <!-- Arc & Chapter List -->
      <section>
        <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 24px; font-family: 'Be Vietnam Pro', sans-serif; letter-spacing: 0.02em;">
          Mục lục các phần (Arc)
        </h2>

        <div style="display: flex; flex-direction: column; gap: 20px;">
          {sortedArcs.map(([arcNum, chapters]) => (
            <div style="border: 1px solid #d5c8b5; border-radius: 6px; background: rgba(255, 255, 255, 0.4); padding: 18px 20px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid rgba(213, 200, 181, 0.6); padding-bottom: 10px;">
                <h3 style="font-size: 17px; font-weight: 700; font-family: 'Be Vietnam Pro', sans-serif;">
                  Phần {arcNum} (Arc {arcNum})
                </h3>
                <span style="font-family: 'Be Vietnam Pro', sans-serif; font-size: 12px; opacity: 0.7;">
                  {chapters.length} chương
                </span>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px;">
                {chapters.map((ch) => (
                  <a
                    href={`/${novel.id}/arc-${ch.data.arc}/chuong-${ch.data.chapter}`}
                    style="display: block; padding: 8px 10px; border-radius: 4px; font-size: 14px; line-height: 1.4; transition: background 0.15s ease;"
                    class="chapter-item-link"
                  >
                    <strong>Chương {ch.data.chapter}:</strong> {ch.data.title}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>

    <footer style="padding: 24px 20px; border-top: 1px solid #d5c8b5; font-family: 'Be Vietnam Pro', sans-serif; font-size: 12px; opacity: 0.75; text-align: center;">
      <p>Bản dịch tiếng Việt phi thương mại của Sakayori Studio.</p>
    </footer>

    <SearchModal />
    <BackToTop />
  </div>
</BaseLayout>

<style>
  .chapter-item-link:hover {
    background: rgba(180, 83, 9, 0.1);
    color: #b45309;
  }
</style>
