---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SearchModal from '../../components/SearchModal.astro';
import ResumeReading from '../../components/ResumeReading.astro';
export async function getStaticPaths() {
  return (await getCollection('novels')).map((novel) => ({ params: { novel: novel.id }, props: { novel } }));
}
const { novel } = Astro.props;
const chapters = (await getCollection('chapters', (c) => c.data.novel === novel.id))
  .sort((a, b) => a.data.arc - b.data.arc || a.data.chapter - b.data.chapter);
const arcs = [...new Set(chapters.map((c) => c.data.arc))];
---
<BaseLayout title={`${novel.data.title} | Sakayori Studio`} description={novel.data.summary.slice(0, 160)}>
  <div class="library-shell">
    <SiteHeader />
    <main id="main-content" class="library-main contents-main">
      <a href="/" class="text-link back-library">← Thư viện</a>
      <header class="novel-intro">
        <h1>{novel.data.title}</h1>
        <p class="novel-credits">{novel.data.author}<span aria-hidden="true"> · </span>Bản dịch: {novel.data.translator}</p>
        <details class="novel-description">
          <summary>Giới thiệu tác phẩm</summary>
          <p>{novel.data.summary}</p>
        </details>
      </header>
      <ResumeReading novel={novel.id} />
      <div class="contents-layout">
        <aside class="arc-index">
          <h2>Mục lục</h2>
          <nav aria-label="Chọn Arc">
            {arcs.map((arc) => <a href={`#arc-${arc}`}>Arc {arc}<span>{chapters.filter((c) => c.data.arc === arc).length} chương</span></a>)}
          </nav>
          <p>Chỉ liệt kê những chương hiện có trên web.</p>
        </aside>
        <div class="contents-chapters">
          {arcs.map((arc, index) => (
            <details class="arc-section" id={`arc-${arc}`}>
              <summary><span>Arc {arc}</span><span class="arc-count">{chapters.filter((c) => c.data.arc === arc).length} chương</span></summary>
              <ol class="chapter-list">
                {chapters.filter((c) => c.data.arc === arc).map((ch) => (
                  <li><a class="chapter-row" href={`/${novel.id}/arc-${arc}/chuong-${ch.data.chapter}`}>
                    <span class="chapter-number">{ch.data.chapter.toString().padStart(2, '0')}</span>
                    <span class="chapter-row-title">{ch.data.title}</span>
                    <span class="reading-marker" hidden>Đang đọc</span>
                    <span class="chapter-arrow" aria-hidden="true">→</span>
                  </a></li>
                ))}
              </ol>
            </details>
          ))}
        </div>
      </div>
    </main>
    <SiteFooter />
    <SearchModal />
  </div>
</BaseLayout>
<script>
  function revealArc() {
    const id = location.hash.slice(1);
    if (!/^arc-\d+$/.test(id)) return;
    const arc = document.getElementById(id);
    if (arc instanceof HTMLDetailsElement) arc.open = true;
  }
  revealArc();
  window.addEventListener('hashchange', revealArc);
  document.querySelectorAll<HTMLAnchorElement>('.arc-index a').forEach((a) => a.addEventListener('click', () => {
    const target = document.getElementById(a.hash.slice(1));
    if (target instanceof HTMLDetailsElement) target.open = true;
  }));
</script>
