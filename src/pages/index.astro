---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchModal from '../components/SearchModal.astro';
import ResumeReading from '../components/ResumeReading.astro';
const novels = await getCollection('novels');
const chapters = await getCollection('chapters');
const library = novels.map((novel) => {
  const entries = chapters.filter((c) => c.data.novel === novel.id)
    .sort((a, b) => a.data.arc - b.data.arc || a.data.chapter - b.data.chapter);
  const arcs = [...new Set(entries.map((c) => c.data.arc))];
  return { novel, entries, arcs };
});
---
<BaseLayout title="Thư viện | Sakayori Studio">
  <div class="library-shell">
    <SiteHeader />
    <main id="main-content" class="library-main">
      <ResumeReading />
      <div class="section-heading">
        <h1>Thư viện</h1>
        <span class="subtle">Bản dịch tiếng Việt</span>
      </div>
      <div class="book-list">
        {library.map(({ novel, entries, arcs }) => (
          <article class="book-entry">
            <a class="title-plate" href={`/${novel.id}/`} aria-label={`Mục lục ${novel.data.title}`}>
              <span class="plate-publisher">Sakayori Studio</span>
              <span class="plate-title">{novel.data.title.startsWith('Re:Zero') ? 'Re:Zero' : novel.data.title}</span>
              <span class="plate-original">{novel.data.title.replace('Re:Zero ', '')}</span>
              <span class="plate-edition">Bản dịch tiếng Việt</span>
            </a>
            <div class="book-info">
              <h2><a href={`/${novel.id}/`}>{novel.data.title}</a></h2>
              <p class="book-author">{novel.data.author}</p>
              <p class="book-summary">{novel.data.summary}</p>
              <div class="book-actions">
                <a class="action-primary" href={`/${novel.id}/`}>Mở mục lục <span aria-hidden="true">→</span></a>
                {entries[0] && <a class="text-link" href={`/${novel.id}/arc-${entries[0].data.arc}/chuong-${entries[0].data.chapter}`}>Đọc từ chương đầu hiện có</a>}
              </div>
              <nav class="arc-shortcuts" aria-label={`Các Arc của ${novel.data.title}`}>
                {arcs.map((arc) => <a href={`/${novel.id}/#arc-${arc}`}>Arc {arc}<span>{entries.filter((c) => c.data.arc === arc).length} chương</span></a>)}
              </nav>
            </div>
          </article>
        ))}
      </div>
    </main>
    <SiteFooter />
    <SearchModal />
  </div>
</BaseLayout>
